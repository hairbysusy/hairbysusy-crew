# Security headers. Netlify applies these to the files it serves; the team app's server
# (netlify/functions/team-api.mjs) sets its own on every answer.

# Every file, both sites. The microphone is allowed only to this site's own pages (the HBS post
# page records the client's voice note for the team, and only after the client taps record and
# allows it); no other site, and nothing framed, can use it.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# The public sign-up pages (crew.hairbysusy.com, and the stylist form at /apply/). On bookhbs.com,
# "/" is the HBS home page, which uses this same policy; its photo collage loads Susy's photos from
# the Hair By Susy site's media (static.wixstatic.com), so "/" and the /book pages allow that host for images.
/
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://static.wixstatic.com; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
/index.html
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
/apply
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
/apply/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
/privacy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; upgrade-insecure-requests
